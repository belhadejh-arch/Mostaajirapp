# ─────────────────────────────────────────────────────────────────
#  MOSTAJIR — Frontend Environment Variables
#  Copy this file to .env.local for local development.
#  Set the same variables in Netlify → Site configuration → Environment variables.
# ─────────────────────────────────────────────────────────────────

# URL of the separately hosted Express API; do not add a trailing slash.
# Example: https://your-api-host.example.com
VITE_API_URL=

# ── App Domain ────────────────────────────────────────────────────
# Your production domain (used for redirect URLs in Chargily payments)
# Example: https://your-site.netlify.app or https://mostajir.dz
VITE_APP_DOMAIN=https://your-site.netlify.app
